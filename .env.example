# Required: models as provider:model
INSIGHT_RAG_LLM=ollama:llama3.1:8b
INSIGHT_RAG_EMBEDDINGS=ollama:nomic-embed-text
# Vector size of the embedding model (768 = nomic-embed-text); fixed at first start
INSIGHT_RAG_EMBEDDING_DIM=768
# In Docker: where the container reaches Ollama on your machine
INSIGHT_RAG_MODEL_BASE_URL=http://host.docker.internal:11434
# Evals only: judge model, kept separate from the chat model
INSIGHT_RAG_JUDGE_LLM=ollama:llama3.1:8b
# Optional: minimum retrieval similarity before answering (calibrated in the baseline)
INSIGHT_RAG_ABSTAIN_THRESHOLD=
# Optional: outside Docker only (alembic needs it); compose sets its own
DATABASE_URL=postgresql://insight_rag:insight_rag@localhost:5432/insight_rag
# Optional: database credentials (local defaults)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
