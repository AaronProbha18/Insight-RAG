# Chat model, as provider:model
PLUMBLINE_LLM=ollama:llama3.1:8b
# Embedding model
PLUMBLINE_EMBEDDINGS=ollama:nomic-embed-text
# Vector size of that embedding model; fixed at first start
PLUMBLINE_EMBEDDING_DIM=768
# Where the container reaches Ollama on your machine (needed in Docker)
PLUMBLINE_MODEL_BASE_URL=http://host.docker.internal:11434
# Eval judge; deliberately separate from the chat model
PLUMBLINE_JUDGE_LLM=ollama:qwen2.5:7b
# Minimum retrieval similarity before answering
PLUMBLINE_ABSTAIN_THRESHOLD=0.3
# Eval summary the quality panel reads (default: evals/reports/latest.summary.json).
# In Docker, mount the file and point this at it.
PLUMBLINE_EVAL_SUMMARY=